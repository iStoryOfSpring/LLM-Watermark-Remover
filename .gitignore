# Python bytecode and local environments
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Python packaging, test and type-checking output
build/
dist/
release/
.venv-macos-arm64/
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Frontend dependencies and build caches
node_modules/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data: uploaded documents, generated outputs, audit logs and local DB
data/jobs/
data/user-dictionaries/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*
*.log

# Local model assets. The Qwen checkpoint is several GB and is intentionally
# kept outside normal source control. The macOS release builder requires the
# checkpoint to exist locally and embeds it into the DMG.
/model/*
!/model/Qwen3.5-2B/
/model/Qwen3.5-2B/*
!/model/Qwen3.5-2B/LICENSE
!/model/Qwen3.5-2B/README.md

# Screenshots and generated site artifacts
output/
.playwright-cli/

# Operating-system and editor files
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
.vscode/
*.swp
*.swo
